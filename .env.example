# Este arquivo nao e carregado pela aplicacao. Ele e apenas um modelo para
# criar o .env em uma instalacao nova: cp .env.example .env

# --- camera ---------------------------------------------------------------
# No Linux, CAM_DEVICE tem prioridade sobre CAM_INDEX. Para escolher uma
# webcam USB sem depender do numero /dev/videoN, use um link listado por:
#   ls -l /dev/v4l/by-id/
# Exemplo:
# CAM_DEVICE=/dev/v4l/by-id/usb-Logitech_HD_Pro_Webcam_C920-video-index0
CAM_INDEX=0
CAM_DEVICE=
CAM_W=1280
CAM_H=720
CAM_FPS=30
FOCO_FIXO=1
FOCO=30

# --- ROI: recorte fixo da bandeja. Zeros = usa o frame inteiro ------------
# Abra /video-cru para alinhar antes da feira.
ROI_X=0
ROI_Y=0
ROI_W=0
ROI_H=0

# --- modelos locais (nada sai da maquina) ---------------------------------
MODELO_DET=models/deteccao.pt
# Vazio = so o detector, sem o estagio de doenca.
MODELO_CLS=models/doenca-resnet50-v5.onnx
# Vazio = auto (usa a GPU se houver). "cpu" forca CPU, "0" forca a primeira GPU.
DEVICE=
IMGSZ=640
# Confianca minima do detector.
CONF_DET=0.40
# Abaixo disso a caixa vira "inconclusivo" (desenhada em cinza).
LIMIAR_CLASSIFICACAO=0.70

# --- visual / servidor ----------------------------------------------------
FONT_PATH=
HOST=0.0.0.0
PORT=8000
